NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional local-only browser QA. Never set these in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Server-only Firebase Admin for production Vercel API routes.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON as base64-encoded JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative individual fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public canonical URL for metadata and sitemap generation.
SITE_FACTORY_BASE_URL=https://gofunmotion.com
NEXT_PUBLIC_SITE_URL=
SITE_FACTORY_LASTMOD=

# Optional transactional email for booking request notifications.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
BOOKING_REQUEST_FALLBACK_EMAIL=
INTERNAL_NOTIFICATIONS_EMAIL=

# Optional salt used only to pseudonymize request IPs in admin audit records.
ADMIN_AUDIT_SALT=

# Server-only OpenAI Responses API. Never expose this key with NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SMART_SEARCH_MODEL=
OPENAI_PLAN_MODEL=
OPENAI_PARTNER_COPY_MODEL=
OPENAI_BOOKING_MESSAGE_MODEL=
OPENAI_LISTING_REVIEW_MODEL=
OPENAI_SUPPORT_MODEL=
OPENAI_TIMEOUT_MS=12000

# Per-user or per-IP daily feature limits. Firestore-backed in production.
AI_SMART_SEARCH_DAILY_LIMIT=40
AI_PLAN_DAILY_LIMIT=20
AI_PARTNER_COPY_DAILY_LIMIT=50
AI_BOOKING_MESSAGE_DAILY_LIMIT=30
AI_LISTING_REVIEW_DAILY_LIMIT=80
AI_SUPPORT_DAILY_LIMIT=40
AI_REQUIRE_PERSISTENT_LIMITS=true

# Server-only Stripe Billing for approved business subscriptions.
# Consumer booking remains request-based and never uses these variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=
