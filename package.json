{
  "name": "site-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/website"
  ],
  "scripts": {
    "dev": "npm --workspace @site-factory/website run dev",
    "prebuild": "npm run sitemap:generate && npm run robots:generate",
    "build": "npm --workspace @site-factory/website run build",
    "postbuild": "npm run check:server-runtime",
    "check:server-runtime": "node --no-experimental-require-module scripts/check-server-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --workspace @site-factory/website run typecheck",
    "test": "vitest run",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"vitest run tests/firestoreRules.test.ts\"",
    "test:marketplace-flow": "firebase emulators:exec --only auth,firestore \"vitest run tests/marketplaceFlow.integration.test.ts\"",
    "test:mobile-workspace": "firebase emulators:exec --project demo-gofunmotion-native --config firebase.native-tests.json --only auth,firestore \"vitest run tests/mobileWorkspace.integration.test.ts\"",
    "test:e2e": "playwright test",
    "seo:audit": "tsx scripts/audit-seo.ts",
    "launch:smoke": "tsx scripts/smoke-launch.ts",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts",
    "robots:generate": "tsx scripts/generate-robots.ts",
    "firestore:seed-demo": "tsx scripts/seedFirestore.ts",
    "admin:bootstrap": "tsx scripts/bootstrapAdmin.ts",
    "wordpress:draft": "tsx scripts/generate-wordpress-draft.ts",
    "content-calendar:generate": "tsx scripts/generate-content-calendar.ts",
    "firebase:login": "firebase login --no-localhost",
    "firebase:login:list": "firebase login:list",
    "firebase:projects": "firebase projects:list",
    "firebase:use": "firebase use",
    "firebase:deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "firebase-tools": "^15.28.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
