rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validUserProfileKeys() {
      return request.resource.data.keys().hasOnly([
        "badges",
        "categoryStats",
        "createdAt",
        "displayName",
        "email",
        "favoriteCategories",
        "isAnonymous",
        "lastLoginAt",
        "lastProgressSyncAt",
        "level",
        "momentumScore",
        "photoURL",
        "preferredCategories",
        "profileUpdatedAt",
        "recentActivity",
        "savedChallengeIds",
        "streak",
        "totalChallengesCompleted",
        "xp"
      ]);
    }

    function validSavedChallengeKeys() {
      return request.resource.data.keys().hasOnly([
        "category",
        "challengeId",
        "description",
        "difficulty",
        "intensity",
        "locationType",
        "moodTags",
        "rarity",
        "safetyNote",
        "savedAt",
        "timeEstimateMinutes",
        "title",
        "whyItHelps",
        "xpReward"
      ]);
    }

    function validCompletedChallengeKeys() {
      return request.resource.data.keys().hasOnly([
        "category",
        "challengeId",
        "completedAt",
        "difficulty",
        "rarity",
        "reflection",
        "source",
        "title",
        "xpEarned"
      ]);
    }

    function validWaitlistEntry() {
      return request.resource.data.keys().hasOnly(["createdAt", "email", "interests", "source"]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserProfileKeys();
      allow delete: if false;

      match /savedChallenges/{challengeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSavedChallengeKeys();
      }

      match /completedChallenges/{completionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCompletedChallengeKeys();
      }
    }

    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /globalStats/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{periodId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /categoryLeaderboards/{category}/periods/{periodId}/entries/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /waitlist/{entryId} {
      allow create: if validWaitlistEntry();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
