rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAdminDoc(userId) {
      return exists(/databases/$(database)/documents/admins/$(userId)) ||
        exists(/databases/$(database)/documents/admin_users/$(userId));
    }

    function isAdmin() {
      return isSignedIn() && hasAdminDoc(request.auth.uid);
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        (
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "superadmin"
          ) ||
          (
            exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == "superadmin"
          )
        );
    }

    function ownsBusinessData(data) {
      return isSignedIn() && (
        ("ownerIds" in data && request.auth.uid in data.ownerIds) ||
        ("ownerUserId" in data && data.ownerUserId == request.auth.uid)
      );
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        ownsBusinessData(get(/databases/$(database)/documents/businesses/$(businessId)).data);
    }

    function isPublishedListingData(data) {
      return (data.status == "published" && data.approvalStatus == "approved") ||
        (data.isApproved == true && data.status in ["approved", "published"]);
    }

    function canReadPublishedListing(data) {
      return isPublishedListingData(data);
    }

    function validAdminRecord() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "displayName",
        "email",
        "role",
        "updatedAt"
      ]) &&
      request.resource.data.role in ["admin", "superadmin"];
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "created_time",
        "accountStatus",
        "city",
        "deletedAt",
        "displayName",
        "display_name",
        "email",
        "isAnonymous",
        "lastLoginAt",
        "onboardingComplete",
        "phone",
        "phone_number",
        "photoURL",
        "photo_url",
        "photoUrl",
        "preferredCategories",
        "preferredCityId",
        "role",
        "uid",
        "updatedAt"
      ]) &&
      (!("uid" in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
      (!("role" in request.resource.data) || request.resource.data.role in ["user", "business", "customer", "provider"]) &&
      (!("accountStatus" in request.resource.data) || request.resource.data.accountStatus in ["active", "pending"]);
    }

    function validCustomerProfileWrite(userId) {
      return request.resource.data.keys().hasOnly([
        "city",
        "createdAt",
        "location",
        "notificationPreferences",
        "preferredCategories",
        "uid",
        "updatedAt"
      ]) &&
      request.resource.data.uid == userId;
    }

    function validProviderProfileCreate(userId) {
      return request.resource.data.keys().hasOnly([
        "avatarUrl",
        "businessAddress",
        "businessName",
        "city",
        "country",
        "coverImageUrl",
        "createdAt",
        "description",
        "hostName",
        "latitude",
        "longitude",
        "phone",
        "placeId",
        "postalCode",
        "ratingAverage",
        "ratingCount",
        "reliabilityLabel",
        "reliabilityScore",
        "socialLinks",
        "state",
        "timezone",
        "uid",
        "updatedAt",
        "verificationStatus",
        "website"
      ]) &&
      request.resource.data.uid == userId &&
      (!("verificationStatus" in request.resource.data) || request.resource.data.verificationStatus in ["unverified", "pending"]) &&
      (!("ratingAverage" in request.resource.data) || request.resource.data.ratingAverage == 0) &&
      (!("ratingCount" in request.resource.data) || request.resource.data.ratingCount == 0) &&
      (!("reliabilityScore" in request.resource.data) || request.resource.data.reliabilityScore == 0);
    }

    function validProviderProfileOwnerUpdate(userId) {
      return request.resource.data.uid == userId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "avatarUrl",
          "businessAddress",
          "businessName",
          "city",
          "country",
          "coverImageUrl",
          "description",
          "hostName",
          "latitude",
          "longitude",
          "phone",
          "placeId",
          "postalCode",
          "socialLinks",
          "state",
          "timezone",
          "updatedAt",
          "website"
        ]);
    }

    function isApprovedActiveDrop(data) {
      return data.status == "active" &&
        data.moderationStatus == "approved" &&
        (!("expiresAt" in data) || data.expiresAt > request.time) &&
        (!("spotsRemaining" in data) || data.spotsRemaining > 0);
    }

    function validDropCreate() {
      return request.resource.data.keys().hasOnly([
        "activityType",
        "capacity",
        "category",
        "city",
        "confirmationMode",
        "createdAt",
        "dealPrice",
        "dealType",
        "description",
        "discountPercent",
        "durationMinutes",
        "endAt",
        "expiresAt",
        "id",
        "imageUrl",
        "latitude",
        "locationFormatted",
        "longitude",
        "moderationStatus",
        "placeId",
        "postalCode",
        "providerId",
        "regularPrice",
        "spotsRemaining",
        "startAt",
        "state",
        "status",
        "timezone",
        "title",
        "updatedAt"
      ]) &&
      request.resource.data.providerId == request.auth.uid &&
      request.resource.data.status in ["draft", "active"] &&
      request.resource.data.moderationStatus in ["draft", "pending_review"] &&
      request.resource.data.confirmationMode in ["instant_reserve", "request_to_confirm"] &&
      request.resource.data.capacity >= 1 &&
      request.resource.data.spotsRemaining >= 0 &&
      request.resource.data.spotsRemaining <= request.resource.data.capacity &&
      request.resource.data.startAt < request.resource.data.endAt &&
      (!("regularPrice" in request.resource.data) || !("dealPrice" in request.resource.data) || request.resource.data.dealPrice <= request.resource.data.regularPrice);
    }

    function validDropOwnerUpdate(data) {
      return data.providerId == request.auth.uid &&
        request.resource.data.providerId == data.providerId &&
        request.resource.data.diff(data).changedKeys().hasOnly([
          "activityType",
          "capacity",
          "category",
          "city",
          "confirmationMode",
          "dealPrice",
          "dealType",
          "description",
          "discountPercent",
          "durationMinutes",
          "endAt",
          "expiresAt",
          "imageUrl",
          "latitude",
          "locationFormatted",
          "longitude",
          "placeId",
          "postalCode",
          "regularPrice",
          "spotsRemaining",
          "startAt",
          "state",
          "status",
          "timezone",
          "title",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["draft", "active", "cancelled", "expired"] &&
        request.resource.data.moderationStatus == data.moderationStatus &&
        request.resource.data.capacity >= 1 &&
        request.resource.data.spotsRemaining >= 0 &&
        request.resource.data.spotsRemaining <= request.resource.data.capacity &&
        request.resource.data.startAt < request.resource.data.endAt &&
        (!("regularPrice" in request.resource.data) || !("dealPrice" in request.resource.data) || request.resource.data.dealPrice <= request.resource.data.regularPrice);
    }

    function validGoFunBookingCreate() {
      return request.resource.data.keys().hasOnly([
        "acceptedAt",
        "completedAt",
        "createdAt",
        "customerEmail",
        "customerId",
        "customerName",
        "customerPhone",
        "declinedAt",
        "dropId",
        "id",
        "message",
        "partySize",
        "providerId",
        "status",
        "updatedAt"
      ]) &&
      request.resource.data.customerId == request.auth.uid &&
      request.resource.data.status == "pending" &&
      exists(/databases/$(database)/documents/drops/$(request.resource.data.dropId)) &&
      isApprovedActiveDrop(get(/databases/$(database)/documents/drops/$(request.resource.data.dropId)).data) &&
      request.resource.data.providerId == get(/databases/$(database)/documents/drops/$(request.resource.data.dropId)).data.providerId &&
      (!("partySize" in request.resource.data) || request.resource.data.partySize >= 1);
    }

    function canProviderUpdateGoFunBooking(data) {
      return data.providerId == request.auth.uid &&
        request.resource.data.customerId == data.customerId &&
        request.resource.data.providerId == data.providerId &&
        request.resource.data.dropId == data.dropId &&
        request.resource.data.diff(data).changedKeys().hasOnly([
          "acceptedAt",
          "completedAt",
          "declinedAt",
          "status",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["accepted", "declined", "cancelled_by_provider", "completed"];
    }

    function canCustomerCancelGoFunBooking(data) {
      return data.customerId == request.auth.uid &&
        data.status == "pending" &&
        request.resource.data.customerId == data.customerId &&
        request.resource.data.providerId == data.providerId &&
        request.resource.data.dropId == data.dropId &&
        request.resource.data.diff(data).changedKeys().hasOnly([
          "status",
          "updatedAt"
        ]) &&
        request.resource.data.status == "cancelled_by_customer";
    }

    function validFavoriteWrite() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "dropId",
        "id",
        "userId"
      ]) &&
      request.resource.data.userId == request.auth.uid;
    }

    function validReviewCreate() {
      return request.resource.data.keys().hasOnly([
        "bookingRequestId",
        "createdAt",
        "customerId",
        "dropId",
        "id",
        "moderationStatus",
        "providerId",
        "rating",
        "tags",
        "text",
        "updatedAt",
        "wouldBookAgain"
      ]) &&
      request.resource.data.customerId == request.auth.uid &&
      request.resource.data.moderationStatus == "pending" &&
      request.resource.data.rating >= 1 &&
      request.resource.data.rating <= 5 &&
      exists(/databases/$(database)/documents/booking_requests/$(request.resource.data.bookingRequestId)) &&
      get(/databases/$(database)/documents/booking_requests/$(request.resource.data.bookingRequestId)).data.customerId == request.auth.uid &&
      get(/databases/$(database)/documents/booking_requests/$(request.resource.data.bookingRequestId)).data.status == "completed" &&
      request.resource.data.dropId == get(/databases/$(database)/documents/booking_requests/$(request.resource.data.bookingRequestId)).data.dropId &&
      request.resource.data.providerId == get(/databases/$(database)/documents/booking_requests/$(request.resource.data.bookingRequestId)).data.providerId;
    }

    function validReportCreate() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "id",
        "message",
        "reason",
        "reporterId",
        "status",
        "targetId",
        "targetType",
        "updatedAt"
      ]) &&
      request.resource.data.reporterId == request.auth.uid &&
      request.resource.data.status == "new" &&
      request.resource.data.targetType in ["drop", "provider", "review", "booking_request", "user"];
    }

    function validDeviceTokenWrite() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "id",
        "isActive",
        "lastSeenAt",
        "platform",
        "token",
        "userId"
      ]) &&
      request.resource.data.userId == request.auth.uid &&
      request.resource.data.platform in ["ios", "android", "web"];
    }

    function validSavedListing() {
      return request.resource.data.keys().hasOnly(["listingId", "savedAt", "listingSnapshot"]);
    }

    function validTopLevelSavedListing() {
      return request.resource.data.keys().hasOnly([
        "city",
        "createdAt",
        "listingId",
        "listingRef",
        "listingSnapshot",
        "listingTitle",
        "savedAt",
        "userId"
      ]) &&
      request.resource.data.userId == request.auth.uid;
    }

    function validSavedPlan() {
      return request.resource.data.keys().hasOnly(["planId", "savedAt", "planSnapshot"]);
    }

    function validTopLevelSavedPlan() {
      return request.resource.data.keys().hasOnly([
        "budget",
        "city",
        "createdAt",
        "persona",
        "planId",
        "planSnapshot",
        "savedAt",
        "summary",
        "userId",
        "vibe",
        "when"
      ]) &&
      request.resource.data.userId == request.auth.uid;
    }

    function validBookingCreate() {
      return request.resource.data.keys().hasOnly([
        "businessId",
        "businessName",
        "businessOwnerIds",
        "cityId",
        "contactEmail",
        "contactName",
        "createdAt",
        "email",
        "listingRef",
        "listingId",
        "listingTitle",
        "message",
        "name",
        "partySize",
        "phone",
        "requestedDate",
        "requestedTime",
        "status",
        "updatedAt",
        "userId"
      ]) &&
      request.resource.data.userId == request.auth.uid &&
      request.resource.data.status in ["pending", "new"];
    }

    function validPartnerApplication() {
      return request.resource.data.keys().hasOnly([
        "averagePrice",
        "businessName",
        "category",
        "categoryId",
        "categoryName",
        "city",
        "cityId",
        "cityName",
        "contactEmail",
        "contactName",
        "createdAt",
        "description",
        "email",
        "instagram",
        "message",
        "offersLastMinuteDeals",
        "ownerName",
        "phone",
        "status",
        "updatedAt",
        "website"
      ]) &&
      request.resource.data.status in ["new", "pending"];
    }

    function validBusinessCreate() {
      return request.resource.data.keys().hasOnly([
        "addressLine1",
        "addressLine2",
        "categories",
        "categoryNames",
        "cityId",
        "cityName",
        "contactEmail",
        "country",
        "createdAt",
        "description",
        "email",
        "instagram",
        "isDemo",
        "latitude",
        "logoUrl",
        "longitude",
        "name",
        "ownerIds",
        "ownerUserId",
        "paidAccessEnabled",
        "phone",
        "photos",
        "postalCode",
        "pricingTier",
        "slug",
        "state",
        "status",
        "updatedAt",
        "verificationStatus",
        "website"
      ]) &&
      ownsBusinessData(request.resource.data) &&
      request.resource.data.status == "pending" &&
      (!("paidAccessEnabled" in request.resource.data) || request.resource.data.paidAccessEnabled == false) &&
      (!("pricingTier" in request.resource.data) || request.resource.data.pricingTier in ["starter", "growth", "pro"]) &&
      (!("verificationStatus" in request.resource.data) || request.resource.data.verificationStatus == "unverified");
    }

    function businessOwnerUpdateAllowed() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "addressLine1",
        "addressLine2",
        "categories",
        "categoryNames",
        "city",
        "cityName",
        "contactEmail",
        "description",
        "email",
        "instagram",
        "logoUrl",
        "name",
        "phone",
        "photos",
        "postalCode",
        "updatedAt",
        "website"
      ]);
    }

    function validPartnerListingCreate() {
      return request.resource.data.keys().hasOnly([
        "approvalStatus",
        "availableDays",
        "availableFrom",
        "availableSlots",
        "availableUntil",
        "bookingMode",
        "bookingUrl",
        "budgetTier",
        "businessId",
        "businessName",
        "businessRef",
        "cancellationNote",
        "capacity",
        "category",
        "categoryIds",
        "city",
        "cityId",
        "cityName",
        "clickCount",
        "createdAt",
        "currency",
        "dealLabel",
        "description",
        "discountPercent",
        "durationMinutes",
        "email",
        "endsAt",
        "featured",
        "groupSize",
        "groupTypes",
        "id",
        "imageUrl",
        "images",
        "indoorOutdoor",
        "isApproved",
        "isDemo",
        "listingType",
        "neighborhood",
        "originalPrice",
        "ownerIds",
        "phone",
        "price",
        "priceLabel",
        "promoted",
        "remainingSpots",
        "requestCount",
        "saveCount",
        "shortDescription",
        "slug",
        "startsAt",
        "status",
        "terms",
        "title",
        "updatedAt",
        "vibeTags",
        "viewCount",
        "whyItFits"
      ]) &&
      "businessId" in request.resource.data &&
      isBusinessOwner(request.resource.data.businessId) &&
      request.resource.data.status in ["draft", "pending_approval"] &&
      (!("approvalStatus" in request.resource.data) || request.resource.data.approvalStatus == "pending") &&
      (!("isApproved" in request.resource.data) || request.resource.data.isApproved == false) &&
      (!("featured" in request.resource.data) || request.resource.data.featured == false) &&
      (!("promoted" in request.resource.data) || request.resource.data.promoted == false) &&
      (!("isDemo" in request.resource.data) || request.resource.data.isDemo == false);
    }

    function partnerListingUpdateKeysAllowed(data) {
      return request.resource.data.diff(data).changedKeys().hasOnly([
        "availableDays",
        "availableFrom",
        "availableSlots",
        "availableUntil",
        "bookingMode",
        "bookingUrl",
        "budgetTier",
        "cancellationNote",
        "capacity",
        "category",
        "categoryIds",
        "city",
        "cityId",
        "cityName",
        "dealLabel",
        "description",
        "discountPercent",
        "durationMinutes",
        "email",
        "endsAt",
        "groupSize",
        "groupTypes",
        "imageUrl",
        "images",
        "indoorOutdoor",
        "listingType",
        "neighborhood",
        "originalPrice",
        "phone",
        "price",
        "priceLabel",
        "remainingSpots",
        "shortDescription",
        "slug",
        "startsAt",
        "status",
        "terms",
        "title",
        "updatedAt",
        "vibeTags",
        "whyItFits"
      ]);
    }

    function partnerListingReviewFieldsLocked(data) {
      return request.resource.data.businessId == data.businessId &&
        (!("approvalStatus" in data) || request.resource.data.approvalStatus == data.approvalStatus) &&
        (!("approvalStatus" in request.resource.data) || "approvalStatus" in data || request.resource.data.approvalStatus == "pending") &&
        (!("isApproved" in data) || request.resource.data.isApproved == data.isApproved) &&
        (!("isApproved" in request.resource.data) || "isApproved" in data || request.resource.data.isApproved == false) &&
        (!("featured" in data) || request.resource.data.featured == data.featured) &&
        (!("promoted" in data) || request.resource.data.promoted == data.promoted);
    }

    function partnerListingStatusAllowed(data) {
      return request.resource.data.status in ["draft", "pending_approval", "paused", "expired"] &&
        (
          data.status != "published" ||
          request.resource.data.diff(data).changedKeys().hasOnly(["status", "updatedAt"])
        );
    }

    function validPartnerListingUpdate(data) {
      return "businessId" in data &&
        isBusinessOwner(data.businessId) &&
        partnerListingUpdateKeysAllowed(data) &&
        partnerListingReviewFieldsLocked(data) &&
        partnerListingStatusAllowed(data);
    }

    function validBookingListingLink() {
      return "listingId" in request.resource.data &&
        exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)) &&
        canReadPublishedListing(get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data) &&
        request.resource.data.businessId == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.businessId &&
        request.resource.data.cityId == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.cityId &&
        (
          !("ownerIds" in get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data) ||
          !("businessOwnerIds" in request.resource.data) ||
          request.resource.data.businessOwnerIds == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerIds
        );
    }

    function validWaitlistEntry() {
      return request.resource.data.keys().hasOnly([
        "city",
        "createdAt",
        "email",
        "interest",
        "interestType",
        "source",
        "userAgent"
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      (
        !("interestType" in request.resource.data) ||
        request.resource.data.interestType in ["user", "business"]
      );
    }

    function canPartnerReadBookingRequest(data) {
      return isSignedIn() && (
        ("businessOwnerIds" in data && request.auth.uid in data.businessOwnerIds) ||
        ("businessId" in data && isBusinessOwner(data.businessId))
      );
    }

    function canPartnerUpdateBookingRequest(data) {
      return canPartnerReadBookingRequest(data) &&
        request.resource.data.diff(data).changedKeys().hasOnly([
          "status",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["contacted", "confirmed", "cancelled", "rejected"];
    }

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isSuperAdmin() && validAdminRecord();
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /admin_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isSuperAdmin() && validAdminRecord();
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && validUserProfile();
      allow delete: if isOwner(userId) || isAdmin();

      match /savedListings/{listingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSavedListing();
      }

      match /savedPlans/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSavedPlan();
      }
    }

    match /customer_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && validCustomerProfileWrite(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /provider_profiles/{userId} {
      allow read: if isOwner(userId) ||
        isAdmin() ||
        resource.data.verificationStatus == "verified";
      allow create: if isOwner(userId) && validProviderProfileCreate(userId);
      allow update: if isAdmin() ||
        (isOwner(userId) && validProviderProfileOwnerUpdate(userId));
      allow delete: if isAdmin();
    }

    match /drops/{dropId} {
      allow read: if isApprovedActiveDrop(resource.data) ||
        (isSignedIn() && resource.data.providerId == request.auth.uid) ||
        isAdmin();
      allow create: if isSignedIn() && validDropCreate();
      allow update: if isAdmin() ||
        (isSignedIn() && validDropOwnerUpdate(resource.data));
      allow delete: if isAdmin() ||
        (isSignedIn() &&
          resource.data.providerId == request.auth.uid &&
          resource.data.status != "active");
    }

    match /booking_requests/{requestId} {
      allow create: if isSignedIn() && validGoFunBookingCreate();
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid) ||
        (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && canProviderUpdateGoFunBooking(resource.data)) ||
        (isSignedIn() && canCustomerCancelGoFunBooking(resource.data));
      allow delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow create, update: if isSignedIn() && validFavoriteWrite();
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.moderationStatus == "approved" ||
        isAdmin() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid) ||
        (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow create: if isSignedIn() && validReviewCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && validReportCreate();
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /admin_actions/{actionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /device_tokens/{tokenId} {
      allow create, update: if isSignedIn() && validDeviceTokenWrite();
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if resource.data.active == true || resource.data.isActive == true || resource.data.comingSoon == true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if resource.data.status == "approved" || ownsBusinessData(resource.data) || isAdmin();
      allow create: if isSignedIn() && validBusinessCreate();
      allow update: if isAdmin() ||
        (ownsBusinessData(resource.data) &&
          businessOwnerUpdateAllowed());
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if canReadPublishedListing(resource.data) ||
        ("businessId" in resource.data && isBusinessOwner(resource.data.businessId)) ||
        isAdmin();
      allow create: if isSignedIn() && validPartnerListingCreate();
      allow update: if isAdmin() ||
        validPartnerListingUpdate(resource.data);
      allow delete: if isAdmin() ||
        ("businessId" in resource.data &&
          isBusinessOwner(resource.data.businessId) &&
          resource.data.status != "published");
    }

    match /savedListings/{savedListingId} {
      allow create: if isSignedIn() && validTopLevelSavedListing();
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validTopLevelSavedListing();
    }

    match /savedPlans/{savedPlanId} {
      allow create: if isSignedIn() && validTopLevelSavedPlan();
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        validTopLevelSavedPlan();
    }

    match /plans/{planId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /bookingRequests/{requestId} {
      allow create: if isSignedIn() && validBookingCreate() && validBookingListingLink();
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        canPartnerReadBookingRequest(resource.data);
      allow update: if isAdmin() ||
        canPartnerUpdateBookingRequest(resource.data);
      allow delete: if isAdmin();
    }

    match /partnerApplications/{applicationId} {
      allow create: if validPartnerApplication();
      allow read, update, delete: if isAdmin();
    }

    match /waitlist/{entryId} {
      allow create: if validWaitlistEntry();
      allow read, update, delete: if isAdmin();
    }

    match /globalStats/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Written only by trusted server routes through Firebase Admin.
    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    // Audit records contain operational metadata, never prompts or response text.
    match /aiAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
