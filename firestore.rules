rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "superadmin";
    }

    function ownsBusinessData(data) {
      return isSignedIn() &&
        "ownerIds" in data &&
        request.auth.uid in data.ownerIds;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        ownsBusinessData(get(/databases/$(database)/documents/businesses/$(businessId)).data);
    }

    function isPublishedListingData(data) {
      return data.status == "published" &&
        data.approvalStatus == "approved" &&
        (!("isDemo" in data) || data.isDemo == false);
    }

    function validAdminRecord() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "displayName",
        "email",
        "role",
        "updatedAt"
      ]) &&
      request.resource.data.role in ["admin", "superadmin"];
    }

    function validUserProfileFields() {
      return request.resource.data.keys().hasOnly([
        "accountStatus",
        "createdAt",
        "deletedAt",
        "displayName",
        "email",
        "isAnonymous",
        "lastLoginAt",
        "notificationPreferences",
        "phone",
        "photoURL",
        "preferredCategories",
        "preferredCityId",
        "role",
        "updatedAt"
      ]) &&
      request.resource.data.role in ["user", "business"] &&
      (!("accountStatus" in request.resource.data) ||
        request.resource.data.accountStatus in ["active", "pending"]);
    }

    function validUserProfileCreate() {
      return validUserProfileFields() && request.resource.data.role == "user";
    }

    function validUserProfileUpdate() {
      return validUserProfileFields() &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!("accountStatus" in resource.data) ||
          request.resource.data.accountStatus == resource.data.accountStatus) &&
        (!("deletedAt" in resource.data) ||
          request.resource.data.deletedAt == resource.data.deletedAt);
    }

    function validSavedListing(listingId) {
      return request.resource.data.keys().hasOnly([
        "listingId",
        "listingSnapshot",
        "savedAt"
      ]) &&
      request.resource.data.listingId == listingId &&
      exists(/databases/$(database)/documents/listings/$(listingId)) &&
      isPublishedListingData(
        get(/databases/$(database)/documents/listings/$(listingId)).data
      );
    }

    function validSavedPlan(planId) {
      return request.resource.data.keys().hasOnly([
        "planId",
        "planSnapshot",
        "savedAt"
      ]) &&
      request.resource.data.planId == planId;
    }

    function validDeviceToken() {
      return request.resource.data.keys().hasOnly([
        "appVersion",
        "createdAt",
        "enabled",
        "lastSeenAt",
        "locale",
        "platform",
        "token",
        "updatedAt"
      ]) &&
      request.resource.data.platform in ["ios", "android", "web"] &&
      request.resource.data.token is string &&
      request.resource.data.token.size() > 20 &&
      request.resource.data.token.size() <= 4096;
    }

    function validBusinessCreate() {
      return request.resource.data.keys().hasOnly([
        "addressLine1", "addressLine2", "categories", "categoryNames",
        "cityId", "cityName", "country", "createdAt", "description",
        "email", "instagram", "isDemo", "latitude", "logoUrl",
        "longitude", "name", "ownerIds", "paidAccessEnabled", "phone",
        "photos", "postalCode", "pricingTier", "slug", "state", "status",
        "updatedAt", "verificationStatus", "website"
      ]) &&
      request.resource.data.ownerIds == [request.auth.uid] &&
      request.resource.data.status == "pending" &&
      request.resource.data.verificationStatus == "unverified" &&
      request.resource.data.isDemo == false &&
      request.resource.data.paidAccessEnabled == false &&
      request.resource.data.pricingTier == "starter" &&
      exists(/databases/$(database)/documents/cities/$(request.resource.data.cityId));
    }

    function validBusinessOwnerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "addressLine1", "addressLine2", "categories", "categoryNames",
        "cityId", "cityName", "country", "description", "email",
        "instagram", "latitude", "logoUrl", "longitude", "name", "phone",
        "photos", "postalCode", "state", "updatedAt", "website"
      ]) &&
      request.resource.data.ownerIds == resource.data.ownerIds &&
      request.resource.data.status == resource.data.status &&
      request.resource.data.verificationStatus == resource.data.verificationStatus &&
      request.resource.data.isDemo == resource.data.isDemo &&
      request.resource.data.paidAccessEnabled == resource.data.paidAccessEnabled &&
      request.resource.data.pricingTier == resource.data.pricingTier &&
      exists(/databases/$(database)/documents/cities/$(request.resource.data.cityId));
    }

    function validPartnerListingCreate() {
      return request.resource.data.keys().hasOnly([
        "approvalStatus", "availableDays", "availableFrom", "availableSlots",
        "availableUntil", "bookingMode", "bookingUrl", "budgetTier",
        "businessId", "businessName", "cancellationNote", "capacity",
        "categoryIds", "cityId", "cityName", "clickCount", "createdAt",
        "currency", "description", "discountPercent", "durationMinutes",
        "email", "featured", "groupSize", "groupTypes", "id", "images",
        "indoorOutdoor", "isDemo", "listingType", "originalPrice",
        "ownerIds", "phone", "price", "promoted", "remainingSpots",
        "requestCount", "saveCount", "shortDescription", "slug", "status",
        "terms", "title", "updatedAt", "vibeTags", "viewCount", "whyItFits"
      ]) &&
      isBusinessOwner(request.resource.data.businessId) &&
      request.resource.data.status in ["draft", "pending_approval"] &&
      request.resource.data.approvalStatus == "pending" &&
      request.resource.data.featured == false &&
      request.resource.data.promoted == false &&
      request.resource.data.isDemo == false &&
      request.resource.data.cityId ==
        get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.cityId;
    }

    function validPartnerListingUpdate() {
      return isBusinessOwner(resource.data.businessId) &&
      request.resource.data.businessId == resource.data.businessId &&
      request.resource.data.ownerIds == resource.data.ownerIds &&
      request.resource.data.cityId == resource.data.cityId &&
      request.resource.data.approvalStatus == resource.data.approvalStatus &&
      request.resource.data.featured == resource.data.featured &&
      request.resource.data.promoted == resource.data.promoted &&
      request.resource.data.isDemo == resource.data.isDemo &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "availableDays", "availableFrom", "availableSlots", "availableUntil",
        "bookingMode", "bookingUrl", "budgetTier", "cancellationNote",
        "capacity", "categoryIds", "description", "discountPercent",
        "durationMinutes", "email", "groupSize", "groupTypes", "images",
        "indoorOutdoor", "listingType", "originalPrice", "phone", "price",
        "remainingSpots", "shortDescription", "slug", "status", "terms",
        "title", "updatedAt", "vibeTags", "whyItFits"
      ]) &&
      request.resource.data.status in ["draft", "pending_approval", "paused", "expired"];
    }

    function validBookingCreate() {
      return request.resource.data.keys().hasOnly([
        "businessId", "businessName", "businessOwnerIds", "cityId",
        "createdAt", "email", "listingId", "listingTitle", "message", "name",
        "partySize", "phone", "requestedDate", "requestedTime", "status",
        "updatedAt", "userId"
      ]) &&
      request.resource.data.userId == request.auth.uid &&
      request.resource.data.status == "pending" &&
      request.resource.data.partySize >= 1 &&
      request.resource.data.partySize <= 50 &&
      exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)) &&
      isPublishedListingData(
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data
      ) &&
      request.resource.data.businessId ==
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.businessId &&
      request.resource.data.cityId ==
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.cityId &&
      request.resource.data.businessOwnerIds ==
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerIds;
    }

    function validPartnerApplication() {
      return request.resource.data.keys().hasOnly([
        "averagePrice", "businessName", "category", "categoryId",
        "categoryName", "city", "cityId", "cityName", "createdAt",
        "description", "email", "instagram", "message",
        "offersLastMinuteDeals", "ownerName", "phone", "status", "updatedAt",
        "website"
      ]) &&
      request.resource.data.status == "new" &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      exists(/databases/$(database)/documents/cities/$(request.resource.data.cityId)) &&
      exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryId));
    }

    function validWaitlistEntry() {
      return request.resource.data.keys().hasOnly([
        "city", "cityId", "createdAt", "email", "interestType", "source",
        "userAgent"
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.interestType in ["user", "business"];
    }

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isSuperAdmin() && validAdminRecord();
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserProfileCreate();
      allow update: if isOwner(userId) && validUserProfileUpdate();
      allow delete: if isAdmin();

      match /savedListings/{listingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSavedListing(listingId);
      }

      match /savedPlans/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSavedPlan(planId);
      }

      match /deviceTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validDeviceToken();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]);
        allow create, delete: if false;
      }
    }

    match /cities/{cityId} {
      allow read: if isAdmin() || resource.data.active == true || resource.data.comingSoon == true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if (
        resource.data.status == "approved" &&
        (!("isDemo" in resource.data) || resource.data.isDemo == false)
      ) || ownsBusinessData(resource.data) || isAdmin();
      allow create: if isSignedIn() && validBusinessCreate();
      allow update: if isAdmin() ||
        (ownsBusinessData(resource.data) && validBusinessOwnerUpdate());
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if isPublishedListingData(resource.data) ||
        ("businessId" in resource.data && isBusinessOwner(resource.data.businessId)) ||
        isAdmin();
      allow create: if isSignedIn() && validPartnerListingCreate();
      allow update: if isAdmin() || validPartnerListingUpdate();
      allow delete: if isAdmin() ||
        (isBusinessOwner(resource.data.businessId) && resource.data.status != "published");
    }

    match /plans/{planId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /bookingRequests/{requestId} {
      allow create: if isSignedIn() && validBookingCreate();
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        ("businessId" in resource.data && isBusinessOwner(resource.data.businessId));
      allow update, delete: if isAdmin();
    }

    match /partnerApplications/{applicationId} {
      allow create: if validPartnerApplication();
      allow read, update, delete: if isAdmin();
    }

    match /waitlist/{entryId} {
      allow create: if validWaitlistEntry();
      allow read, update, delete: if isAdmin();
    }

    match /globalStats/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /emailDeliveryEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /businessBilling/{businessId} {
      allow read, write: if false;
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    match /aiAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
