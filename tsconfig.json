{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "apps/website/src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/website/.next"
  ]
}
